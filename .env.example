# ---------------------------------------------------------------------------
# BNPL local development environment.
# Copy to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# MySQL 8 (docker compose)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=bnpl
MYSQL_USER=bnpl
MYSQL_PASSWORD=bnplpw

# Application connection used by the running services. multiStatements MUST be
# disabled here to avoid widening the SQL-injection surface.
DB_DSN=bnpl:bnplpw@tcp(127.0.0.1:3306)/bnpl?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_0900_ai_ci

# Migration-only connection. golang-migrate needs multiStatements=true to apply
# the multi-statement SQL files. Never use this DSN to serve traffic.
MIGRATE_DSN=bnpl:bnplpw@tcp(127.0.0.1:3306)/bnpl?parseTime=true&loc=UTC&multiStatements=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci

# HTTP
CHECKOUT_HTTP_ADDR=:8081
UNDERWRITING_HTTP_ADDR=:8082
LOG_LEVEL=info

# Background settlement worker (cmd/worker, docs/0003)
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL=15s
WORKER_STALE_AFTER=5m
