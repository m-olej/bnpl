# ---------------------------------------------------------------------------
# BNPL local development environment.
# Copy to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# MySQL 8 (docker compose)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=bnpl
MYSQL_USER=bnpl
MYSQL_PASSWORD=bnplpw

# Go services. The DSN is intentionally explicit so that migrations can enable
# multiStatements (required by golang-migrate for multi-statement SQL files).
DB_DSN=bnpl:bnplpw@tcp(127.0.0.1:3306)/bnpl?parseTime=true&loc=UTC&multiStatements=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci

# HTTP
CHECKOUT_HTTP_ADDR=:8081
UNDERWRITING_HTTP_ADDR=:8082
LOG_LEVEL=info
